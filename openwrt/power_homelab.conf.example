# =============================================================================
# OpenWrt Homelab Power Orchestrator Configuration (Template)
# File: /etc/power_homelab.conf
# =============================================================================

# --- Telegram Bot Credentials ---
# Telegram Bot API Token obtained from @BotFather
BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Comma-separated list of allowed Telegram user IDs that are authorized to run control commands
# e.g. "8881234,9994321". Get yours via @userinfobot or @GetMyIDBot
ALLOWED_USER_IDS="YOUR_TELEGRAM_USER_ID"

# Set to "1" to temporarily suspend all automated Telegram and Discord notifications (e.g. during maintenance)
DISABLE_NOTIFICATIONS="0"

# Optional Target Telegram Chat ID(s) for all wake notifications (can be user IDs or group chat IDs).
# Multiple chat IDs can be defined, separated by commas or spaces.
# If empty, defaults to the first ID in ALLOWED_USER_IDS. Group IDs typically start with a minus sign (e.g., -100123456).
NOTIFY_CHAT_ID=""

# --- Target Host Configuration ---
# The IP address of the Proxmox VE host
HOST_IP="192.168.11.10"

# The physical MAC address of the Proxmox VE host (used for Wake-on-LAN)
HOST_MAC="aa:bb:cc:dd:ee:ff"

# The network interface on OpenWrt for LAN / WoL (defaults to br-lan, e.g. br-lan.1 for VLAN 1)
LAN_INTERFACE="br-lan"

# Path to the Dropbear/OpenSSH private key used for passwordless SSH access to Proxmox
SSH_KEY_PATH="/etc/dropbear/id_dropbear"

# SSH port of the Proxmox VE host (change if you use a non-standard SSH port, defaults to 22)
HOST_SSH_PORT="22"

# SSH user on Proxmox VE host (defaults to "root", e.g. "adminuser")
HOST_SSH_USER="root"

# --- Network Wake-on-Demand Ports ---
# Comma-separated list of HTTP TCP ports on the Proxmox host that should be intercepted
# and redirected to the beautiful local waking page (port 8080) when Proxmox is sleeping.
HTTP_REDIRECT_PORTS="80,8123"

# Comma-separated list of HTTPS TCP ports on the Proxmox host that should be intercepted
# and redirected to the local waking page over SSL (port 8443) when Proxmox is sleeping.
# Common: 443, 8006 (Proxmox UI)
HTTPS_REDIRECT_PORTS="443,8006"

# Comma-separated list of game ports that should run local wake listeners when Proxmox
# is sleeping. When a client tries to connect, it triggers a wake-on-LAN immediately.
# Syntax: Add '/udp' suffix for UDP ports. Defaults to TCP if no suffix is specified.
# Common:
# - 25565: Minecraft Java (TCP)
# - 19132/udp: Minecraft Bedrock (UDP)
# - 27015/udp,27016/udp: Unturned Steam Server (UDP query and game ports)
GAME_REDIRECT_PORTS="25565,19132/udp,27015/udp,27016/udp"


# --- Orchestration Daemon Tuning ---
# Interval in seconds to check if the Proxmox host is alive (ping)
CHECK_INTERVAL="5"

# Number of consecutive ping failures before declaring the host is asleep (S3)
PING_RETRIES="3"

# --- Multi-Guest Dynamic Orchestration Map ---
# Comma-separated list of individual VMs/LXCs that should auto-sleep/wake dynamically.
# Format: "VMID:IP_ADDRESS:PORT/PROTOCOL:IDLE_MINUTES"
# Must match the settings configured in Proxmox /etc/power_homelab.conf.
# Example: "101:192.168.11.50:25565/tcp:15,102:192.168.11.60:19132/udp:15"
# Leave empty if not using individual guest sleep/wake orchestration.
GUEST_ORCHESTRATION_MAP=""

# --- Safe Shutdown / Reboot Exemptions ---
# Comma-separated list of VMIDs that represent "always running" core services (e.g. NAS, Nginx, Pihole).
# These guests will NOT statically block `/hostshutdown` or `/hostreboot` from the Telegram bot.
# The host will still safely verify that these instances are NOT actively in use (CPU, Network Rate, Ports)
# on Proxmox before shutting down!
EXEMPT_SHUTDOWN_GUESTS=""

# --- Anti-Accidental Wake Port Listeners ---
# Enable or disable the raw TCP/UDP port Wake-on-Demand listeners on the router.
# Set to "0" (Recommended) to prevent background internet port scans or client server list pings from waking guests.
# If "0", guests are safely woken ONLY via the Telegram Bot.
ENABLE_PORT_WAKE_LISTENERS="0"

# --- Discord Webhook Notifications (Optional) ---
# Generate one or more webhook URLs in your Discord App Channel settings to send rich status embeds.
# Multiple webhook URLs can be defined, separated by commas or spaces.
# e.g., "https://discord.com/api/webhooks/123/abc,https://discord.com/api/webhooks/456/def"
DISCORD_WEBHOOK_URL=""

# --- Multi-Tenant Guest Service Names ---
# Mapping of Guest VMIDs to their friendly service names. Used to label guest
# notifications (e.g. "Minecraft") instead of showing a bare VMID.
# Format: "VMID:NAME,VMID:NAME"
GUEST_NAME_MAP="120:Minecraft,122:Unturned"

# --- Proxmox Host Idle Detection & Suspension Settings ---
# These parameters will be synchronized to Proxmox /etc/power_homelab.conf

# CPU load average threshold to consider system idle (e.g. 0.15 = 15% of a core/system capacity)
CPU_THRESHOLD="0.15"

# Automatically multiply CPU_THRESHOLD by number of host cores (1 = Enabled/Yes, 0 = Disabled/No)
SCALE_CPU_THRESHOLD_BY_CORES=1

# Network interface to monitor for active traffic (typically vmbr0)
NET_INTERFACE="vmbr0"

# Network traffic rate threshold in KB/s. Active if 10s average exceeds this.
NET_THRESHOLD_KBPS="50"

# Active TCP ports which block sleep if established client connections exist
MONITORED_PORTS="25565,32400,8006,8123,22"

# Safe power management modes for guests
# LXC Options: stop (clean shutdown, recommended to avoid CRIU failures), suspend (stateful freeze)
LXC_SUSPEND_METHOD="stop"
# VM Options: shutdown (ACPI stop, recommended for GPU passthrough), suspend (stateful snapshot)
VM_SUSPEND_METHOD="shutdown"

# Processes that block host shutdown/sleep
PROTECTED_PROCESSES="vzdump qm pct rsync proxmox-backup-client apt-get dpkg"

# Time windows where the host must stay awake (e.g. "Mon-Fri:18:00-00:00" or "Mon-Sun:05:00-23:00")
# - During this window: The Proxmox host skips idle checks and will NOT suspend automatically.
# - Outside this window: The Proxmox host performs idle checks and auto-suspends when idle.
# - Note: ACTIVE_TIME_WINDOWS alone does NOT power on/wake the host when the window starts (since host is asleep).
#   To automatically wake the host at the start time (e.g. 05:00 AM daily), schedule a cron job on OpenWrt:
#   1. Run 'crontab -e' on OpenWrt
#   2. Add: 0 5 * * * etherwake -b -i br-lan <HOST_MAC>
#   3. Ensure cron service is enabled: /etc/init.d/cron enable && /etc/init.d/cron start
ACTIVE_TIME_WINDOWS=""

# Logging settings for Proxmox host
LOG_FILE="/var/log/proxmox_power.log"
ENABLE_SYSLOG=1

# --- Proxmox Host Resource & Service Monitoring Settings ---
# CPU usage threshold in percentage to trigger warning alert (0-100)
MONITOR_CPU_THRESHOLD_PCT=85

# RAM usage threshold in percentage to trigger warning alert (0-100)
MONITOR_RAM_THRESHOLD_PCT=90

# Disk usage threshold in percentage to trigger warning alert (0-100)
MONITOR_DISK_THRESHOLD_PCT=90

# Space-separated filesystems/directories to check for disk utilization
MONITOR_DISK_PATHS="/ /var/lib/vz"

# Systemd services to monitor on the Proxmox host
MONITOR_SERVICES="pvedaemon pveproxy pvestatd"

# ZFS pools to check health status (space-separated, e.g. "rpool", or "all" to check all pools)
MONITOR_ZFS_POOLS="rpool"

# Comma-separated list of critical Guest VM/LXC IDs that should be alert-monitored if stopped
MONITOR_CRITICAL_GUESTS=""

# Cooldown period in seconds before repeating a warning notification for a persistent issue (default: 4 hours)
MONITOR_COOLDOWN_SEC=14400
