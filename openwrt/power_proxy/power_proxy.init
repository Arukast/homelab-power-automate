#!/bin/sh /etc/rc.common
# =============================================================================
# OpenWrt Power Proxy Daemon Service
# File: /etc/init.d/power_proxy
# =============================================================================

START=98
STOP=11

USE_PROCD=1

# Shared configuration path constants (components/lib.sh). Sourcing it is
# optional so that a damaged installation still fails on the missing config
# below instead of erroring out while loading the init script.
[ -f /usr/bin/components/lib.sh ] && . /usr/bin/components/lib.sh
ROUTER_CONF="${ROUTER_CONF:-/etc/power_homelab.conf}"

start_service() {
    # Check config exists (generated by the installer at $ROUTER_CONF)
    [ -f "$ROUTER_CONF" ] || return 1

    procd_open_instance
    procd_set_param command /usr/bin/power_proxy_daemon.sh
    procd_set_param respawn 3600 5 0 # Respawn indefinitely if crash occurs
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
